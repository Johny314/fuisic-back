{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "include-component-in-tag": false,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Возможности"
        },
        {
          "type": "fix",
          "section": "Исправления"
        },
        {
          "type": "perf",
          "section": "Производительность"
        },
        {
          "type": "refactor",
          "section": "Рефакторинг"
        },
        {
          "type": "deps",
          "section": "Зависимости"
        },
        {
          "type": "docs",
          "section": "Документация"
        },
        {
          "type": "chore",
          "section": "Прочее",
          "hidden": true
        },
        {
          "type": "style",
          "section": "Стиль",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Тесты",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "CI",
          "hidden": true
        },
        {
          "type": "build",
          "section": "Сборка",
          "hidden": true
        }
      ]
    }
  }
}
