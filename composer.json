{
    "name": "fuisic/back",
    "type": "project",
    "description": "FUISIC API: sections, card sets, tests and Backpack admin.",
    "keywords": [
        "fuisic",
        "laravel",
        "api"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "backpack/crud": "6.*",
        "backpack/theme-tabler": "^1.2",
        "darkaonline/l5-swagger": "^8.6",
        "fuisic/auth": "@dev",
        "kerigard/laravel-lang-ru": "^2.0",
        "laravel/framework": "^11.31",
        "laravel/sanctum": "^4.1",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.28",
        "spatie/laravel-data": "^4.6",
        "spatie/laravel-query-builder": "^6.2"
    },
    "require-dev": {
        "backpack/generators": "^4.0",
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.19",
        "laravel/telescope": "^5.7",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "11.3.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../fuisic-auth",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
